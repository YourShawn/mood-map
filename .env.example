# Copy to .env and adjust. Used by Docker Compose and local backend.
# Never commit .env. Do not put a public IP or public DNS name for MySQL.

# --- MySQL ---
# Local processes (mvn / tests): loopback only.
# Production/server: private hostname or localhost via uncommitted .env.
# Docker Compose talking to MySQL on the same host: host.docker.internal
#   (or the host gateway). Linux Compose maps this via extra_hosts.
# Bundled demo (`docker compose --profile bundled-mysql`): mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=moodmap
MYSQL_USER=moodmap
MYSQL_PASSWORD=moodmap_dev
MYSQL_ROOT_PASSWORD=changeme_root

# --- Backend ---
SERVER_PORT=8080
JWT_SECRET=replace-with-at-least-32-chars-of-random
JWT_TTL_HOURS=720
MOOD_TTL_HOURS=24
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:80,http://localhost:8080

# Nearby search defaults
MOOD_DEFAULT_RADIUS_KM=5
MOOD_MAX_RADIUS_KM=50
MOOD_NEARBY_LIMIT=200
MOOD_MIN_INTERVAL_SECONDS=10
